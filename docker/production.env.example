# 复制为 docker/production.env；密钥正文放入 DEVMIND_SECRETS_DIR。
APP_ENV=production
APP_DEBUG=false
CLAMAV_ENABLED=true
DEVMIND_SECRETS_DIR=./secrets

BACKEND_IMAGE=devmind-backend:2026.08.29
WEB_IMAGE=devmind-web:2026.08.29
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
CORS_ORIGINS=https://devmind.example.com

POSTGRES_DB=internal_tech_kb
POSTGRES_USER=devmind
MINIO_BUCKET=devmind-documents
MILVUS_DATABASE=internal_tech_kb
MILVUS_COLLECTION=internal_tech_kb
BGE_DEVICE=cpu
